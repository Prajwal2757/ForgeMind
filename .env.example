# Required: 32+ random characters. Generate: python -c "import secrets;print(secrets.token_hex(32))"
FORGEMIND_SECRET=
# Public DNS name. "localhost" gives a locally signed certificate.
FORGEMIND_DOMAIN=localhost
# extractive (no key, quotes sentences only) | anthropic | openai
FORGEMIND_LLM=extractive
FORGEMIND_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# hashing (offline, not semantic) | openai
FORGEMIND_EMBEDDINGS=hashing
# Set to enable /metrics (send as a Bearer token)
FORGEMIND_METRICS_TOKEN=
# Seconds a sign-in lasts
FORGEMIND_TOKEN_TTL=3600
# If you raise this, raise max_size in deploy/Caddyfile too
FORGEMIND_MAX_UPLOAD=10485760
# Stored text chunks allowed per organisation
FORGEMIND_MAX_CHUNKS_PER_TENANT=50000
